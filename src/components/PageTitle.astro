---
type GuideStatus = 'Released' | 'Preview' | 'Unreleased';

interface GuideData {
  title: string;
  description?: string;
  status: GuideStatus;
  platforms: string[];
  version: string;
  limitations: string;
  privacy: string;
  recovery: string;
  expectedResult?: string;
}

const data = Astro.locals.starlightRoute.entry.data as GuideData;
const statusTone = data.status.toLocaleLowerCase('en-US');
---

<div class="guide-heading">
  <p class="guide-eyebrow">Sangrep Workbench guide</p>
  <h1 id="_top">{data.title}</h1>
  {data.description && <p class="guide-description">{data.description}</p>}

  <section class="release-lens-frame" aria-labelledby="guide-status-heading">
    <h2 id="guide-status-heading" class="guide-status-heading">Guide status</h2>
    <dl data-guide-status={data.status} class="release-lens">
      <div class={`release-lens__item release-lens__item--${statusTone}`}>
        <dt>Status</dt>
        <dd>{data.status}</dd>
      </div>
      <div class="release-lens__item">
        <dt>Platform</dt>
        <dd>{data.platforms.join(' · ')}</dd>
      </div>
      <div class="release-lens__item">
        <dt>Version</dt>
        <dd>{data.version}</dd>
      </div>
      <div class="release-lens__item release-lens__item--wide">
        <dt>Privacy</dt>
        <dd>{data.privacy}</dd>
      </div>
      <div class="release-lens__item release-lens__item--wide">
        <dt>Limitations</dt>
        <dd>{data.limitations}</dd>
      </div>
      <div class="release-lens__item release-lens__item--wide">
        <dt>Recovery</dt>
        <dd>{data.recovery}</dd>
      </div>
    </dl>
  </section>

  {
    data.expectedResult && (
      <aside class="expected-result" aria-label="Expected result">
        <span>Expected result</span>
        <p>{data.expectedResult}</p>
      </aside>
    )
  }
</div>

<style>
  .guide-heading {
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
  }

  .guide-eyebrow {
    margin: 0 0 0.75rem;
    color: var(--sl-color-accent-high);
    font-family: var(--sg-font-utility);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    color: var(--sl-color-white);
    font-family: var(--sg-font-display);
    font-size: clamp(2.4rem, 7vw, 4.8rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .guide-description {
    max-width: 64ch;
    margin: 1.25rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.55;
  }

  .guide-status-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .release-lens {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2rem 0 0;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-inline-start: 0.3rem solid var(--sl-color-accent);
    border-radius: 0.8rem;
    background: var(--sl-color-bg-nav);
    box-shadow: 0 1.25rem 3rem -2.5rem color-mix(in srgb, var(--sl-color-black) 50%, transparent);
  }

  .release-lens__item {
    min-width: 0;
    padding: 0.85rem 1rem 0.95rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
    border-block-end: 1px solid var(--sl-color-gray-5);
  }

  .release-lens__item:nth-child(3),
  .release-lens__item:last-child {
    border-inline-end: 0;
  }

  .release-lens__item:nth-last-child(-n + 3) {
    border-block-end: 0;
  }

  .release-lens__item--wide {
    min-height: 6.4rem;
  }

  dt {
    margin: 0 0 0.35rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sg-font-utility);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .release-lens__item--released dd {
    color: var(--sg-color-released);
    font-weight: 700;
  }

  .release-lens__item--preview dd,
  .release-lens__item--unreleased dd {
    color: var(--sg-color-caution);
    font-weight: 700;
  }

  .expected-result {
    display: grid;
    grid-template-columns: minmax(8rem, 0.3fr) 1fr;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--sl-color-accent-low);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--sl-color-accent-low) 62%, transparent);
  }

  .expected-result span {
    color: var(--sl-color-accent-high);
    font-family: var(--sg-font-utility);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .expected-result p {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  @media (max-width: 46rem) {
    h1 {
      font-size: clamp(2.2rem, 13vw, 3.4rem);
    }

    .release-lens {
      grid-template-columns: 1fr;
    }

    .release-lens__item,
    .release-lens__item:nth-child(3),
    .release-lens__item:nth-last-child(-n + 3) {
      min-height: auto;
      border-inline-end: 0;
      border-block-end: 1px solid var(--sl-color-gray-5);
    }

    .release-lens__item:last-child {
      border-block-end: 0;
    }

    .expected-result {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
